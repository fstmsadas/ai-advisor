# ========== 数据库配置 ==========
# MySQL 连接信息（容器内使用服务名 mysql）
DB_HOST=mysql
DB_PORT=3306
DB_USER=container_user
DB_PASSWORD=<strong-password>
DB_NAME=myapp
DB_CONNECT_TIMEOUT=10

# ========== Redis 配置 ==========
REDIS_HOST=redis
REDIS_PORT=6379

# ========== AI 服务（DeepSeek）==========
DEEPSEEK_API_KEY=<your-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# ========== 应用配置 ==========
# Flask 加密密钥（用于 session、签名），使用 `openssl rand -hex 32` 生成
SECRET_KEY=<random-secret-key>
DEBUG=False
CPU_THRESHOLD=80
LOG_FILE_PATH=/var/log/syslog

# ========== MySQL 容器专用（仅供内部使用）==========
# 这些变量在 docker-compose.yml 中引用，需与 DB_PASSWORD 保持一致
MYSQL_ROOT_PASSWORD=<root-password>
MYSQL_DATABASE=myapp
MYSQL_USER=container_user
# MYSQL_PASSWORD 与 DB_PASSWORD 相同，无需重复定义
